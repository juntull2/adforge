# API Keys for LLM Providers
# 대본 생성 엔진 (OpenRouter Claude 3.5 Sonnet)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxyour_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here


# Settings
MIN_RESOLUTION_WIDTH=1080
MIN_RESOLUTION_HEIGHT=1080
MAX_SEARCH_RETRIES=3

# Naver Search Advisor API Keys
NAVER_CUSTOMER_ID=your_naver_customer_id_here
NAVER_ACCESS_LICENSE=your_naver_access_license_here
NAVER_SECRET_KEY=your_naver_secret_key_here

# Naver Open API (DataLab Trend / Demographics)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Facebook / Meta API
FACEBOOK_USER_ACCESS_TOKEN=your_facebook_access_token_here

# Obsidian Vault Path
OBSIDIAN_VAULT_PATH=
