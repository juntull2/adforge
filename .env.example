# API Keys for LLM Providers
# 대본 생성 엔진 (OpenRouter Claude 3.5 Sonnet)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxyour_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# API Keys for Stock Footage Providers
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Settings
MIN_RESOLUTION_WIDTH=1080
MIN_RESOLUTION_HEIGHT=1080
MAX_SEARCH_RETRIES=3

# Naver Search Advisor API Keys
NAVER_CUSTOMER_ID=your_naver_customer_id
NAVER_ACCESS_LICENSE=your_naver_access_license
NAVER_SECRET_KEY=your_naver_secret_key

# Naver DataLab API (네이버 검색어 트렌드 / 연령·성별)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Notion API 연동
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Google Drive API 연동
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/your_folder_id
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
